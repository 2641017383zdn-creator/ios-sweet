+/* Low-cost sample of the actual mapped pixel bytes (32x32 grid, BGRA). */
+static uint64_t
+sweet_diag_pixel_hash(uintptr_t base, uint32_t stride, int32_t w, int32_t h,
+    uint32_t *nonblack)
+{
+	uint64_t hash = 14695981039346656037ULL;
+	uint32_t count = 0;
+	for (uint32_t iy = 0; iy < 32; iy++) {
+		uint32_t y = (uint32_t)(((uint64_t)(iy * 2 + 1) * (uint32_t)h) / 64);
+		for (uint32_t ix = 0; ix < 32; ix++) {
+			uint32_t x = (uint32_t)(((uint64_t)(ix * 2 + 1) * (uint32_t)w) / 64);
+			const volatile uint32_t *pixel = (const volatile uint32_t *)(
+			    base + (uint64_t)y * stride + (uint64_t)x * 4);
+			uint32_t value = *pixel;
+			hash ^= (uint64_t)value;
+			hash *= 1099511628211ULL;
+			if ((value & 0x00ffffffU) != 0) {
+				count++;
+			}
+		}
+	}
+	*nonblack = count;
+	return hash;
+}
